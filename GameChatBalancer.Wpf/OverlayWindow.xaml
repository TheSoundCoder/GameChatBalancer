<Window x:Class="GameChatBalancer.Wpf.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        ShowInTaskbar="False"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="360"
        Height="180"
        ShowActivated="False"
        Focusable="False"
        WindowStartupLocation="Manual">
    <Border CornerRadius="18"
            Background="#CC101A2B"
            BorderBrush="#66738AAD"
            BorderThickness="1"
            Padding="16"
            SnapsToDevicePixels="True">
        <StackPanel>
            <TextBlock Text="GameChatBalancer"
                       FontSize="18"
                       FontWeight="SemiBold"
                       Foreground="#FFF3F7FF" />

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="GameValueText"
                           Text="🎮 100%"
                           FontSize="22"
                           FontWeight="Bold"
                           Foreground="#FF60A5FA" />

                <TextBlock x:Name="ChatValueText"
                           Grid.Column="1"
                           Text="💬 100%"
                           FontSize="22"
                           FontWeight="Bold"
                           HorizontalAlignment="Right"
                           Foreground="#FFB388FF" />
            </Grid>

            <StackPanel Margin="0,14,0,0">
                <Grid Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Game"
                               Width="52"
                               VerticalAlignment="Center"
                               Foreground="#FFF3F7FF" />
                    <Border Grid.Column="1"
                            x:Name="GameTrack"
                            Height="10"
                            CornerRadius="5"
                            Background="#33476468"
                            VerticalAlignment="Center">
                        <Border x:Name="GameBar"
                                HorizontalAlignment="Left"
                                Height="10"
                                CornerRadius="5"
                                Width="0"
                                Background="#FF60A5FA" />
                    </Border>
                </Grid>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Chat"
                               Width="52"
                               VerticalAlignment="Center"
                               Foreground="#FFF3F7FF" />
                    <Border Grid.Column="1"
                            x:Name="ChatTrack"
                            Height="10"
                            CornerRadius="5"
                            Background="#33476468"
                            VerticalAlignment="Center">
                        <Border x:Name="ChatBar"
                                HorizontalAlignment="Left"
                                Height="10"
                                CornerRadius="5"
                                Width="0"
                                Background="#FFB388FF" />
                    </Border>
                </Grid>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
