<Window x:Class="GameChatBalancer.Wpf.SystrayPopupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="GameChatBalancer Tray"
        Width="332"
        Height="460"
        WindowStyle="None"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        AllowsTransparency="True"
        Background="Transparent"
        WindowStartupLocation="Manual"
        KeyDown="SystrayPopupWindow_KeyDown"
        Topmost="True">
    <Border Style="{StaticResource CardBorderStyle}" Padding="12" Margin="0">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <StackPanel Grid.Row="0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="&#xE8D2;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="18"
                               Foreground="{StaticResource Brush.AccentGame}"
                               VerticalAlignment="Center" />
                    <TextBlock Text="GameChatBalancer"
                               Margin="10,0,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}"
                               VerticalAlignment="Center" />
                </StackPanel>

                <Border Height="1" Margin="0,10,0,10" Background="{StaticResource Brush.BorderSubtle}" />

                <!-- 1) Arduino verbunden? -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <Ellipse x:Name="statusDot"
                             Width="12"
                             Height="12"
                             Fill="{StaticResource Brush.Success}"
                             VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                        <TextBlock x:Name="statusTitle"
                                   Text="Arduino verbunden"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock x:Name="statusSubtitle"
                                   Text="Hardware-Steuerung aktiv"
                                   Margin="0,2,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>

                </Grid>

                <Border Height="1" Margin="0,12,0,10" Background="{StaticResource Brush.BorderSubtle}" />

                <!-- 2) Aktuelle Werte -->
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE8BD;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.AccentChat}" />
                                <TextBlock Text="Chat"
                                           Margin="6,0,0,0"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                            </StackPanel>
                            <TextBlock x:Name="txtChatPercent"
                                       Text="30%"
                                       Foreground="{StaticResource Brush.AccentChat}"
                                       FontWeight="Bold"
                                       FontSize="20" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" HorizontalAlignment="Right">
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                <TextBlock Text="Game"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Text="&#xE7FC;"
                                           Margin="6,0,0,0"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.AccentGame}" />
                            </StackPanel>
                            <TextBlock x:Name="txtGamePercent"
                                       Text="70%"
                                       Foreground="{StaticResource Brush.AccentGame}"
                                       FontWeight="Bold"
                                       FontSize="20"
                                       HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>

                    <Grid x:Name="balanceTrackHost" Margin="0,10,0,0" SizeChanged="BalanceTrackHost_OnSizeChanged">
                        <Border Height="10" CornerRadius="5">
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                    <GradientStop Color="{StaticResource Color.AccentChat}" Offset="0" />
                                    <GradientStop Color="#5A74D3" Offset="0.5" />
                                    <GradientStop Color="{StaticResource Color.AccentGame}" Offset="1" />
                                </LinearGradientBrush>
                            </Border.Background>
                        </Border>
                        <Canvas IsHitTestVisible="False">
                            <Ellipse x:Name="balanceIndicator"
                                     Width="20"
                                     Height="20"
                                     Fill="{StaticResource Brush.TextPrimary}"
                                     Stroke="{StaticResource Brush.BorderSubtle}"
                                     StrokeThickness="1"
                                     Canvas.Top="-5" />
                        </Canvas>
                    </Grid>
                </StackPanel>

                <Border Height="1" Margin="0,12,0,10" Background="{StaticResource Brush.BorderSubtle}" />

                <!-- 3) Arduino Settings ODER Software-Steuerung -->
                <StackPanel x:Name="connectedControlsSection">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="&#xE8AB;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       Foreground="{StaticResource Brush.TextSecondary}"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="Invert Control"
                                       Margin="8,0,0,0"
                                       FontFamily="Segoe UI"
                                       FontSize="14"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                        <ToggleButton x:Name="invertControlToggle"
                                      Grid.Column="1"
                                      Style="{StaticResource HardwareToggleStyle}"
                                      IsChecked="False"
                                      Checked="InvertControlToggle_Changed"
                                      Unchecked="InvertControlToggle_Changed" />
                    </Grid>
                </StackPanel>

                <Border x:Name="disconnectedControlsSection"
                        Visibility="Collapsed"
                        Background="{StaticResource Brush.Surface1}"
                        BorderBrush="{StaticResource Brush.BorderSubtle}"
                        BorderThickness="1"
                        CornerRadius="10"
                        Padding="10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="&#xE7F8;"
                                       FontFamily="Segoe MDL2 Assets"
                                       FontSize="14"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource Brush.TextSecondary}" />
                            <TextBlock Text="Software Control"
                                       Margin="8,0,0,0"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                        </StackPanel>
                        <TextBlock Text="Ctrl + Shift + ← / → / ↓"
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Text="Adjust the game/chat balance in 5% steps."
                                   Margin="0,4,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- 4) Buttons und Settings -->
            <StackPanel Grid.Row="2" VerticalAlignment="Bottom">
                <Border Height="1" Margin="0,0,0,10" Background="{StaticResource Brush.BorderSubtle}" />

                <Button x:Name="openAppButton"
                        Click="OpenAppButton_Click"
                        Height="34"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        HorizontalContentAlignment="Stretch"
                        Padding="4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8A7;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Text="Open App"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                    </Grid>
                </Button>

                <Grid Margin="4,4,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="&#xE7F8;"
                               FontFamily="Segoe MDL2 Assets"
                               FontSize="14"
                               VerticalAlignment="Center"
                               Foreground="{StaticResource Brush.TextSecondary}" />
                    <TextBlock Grid.Column="1"
                               Margin="10,0,0,0"
                               Text="Start with Windows"
                               VerticalAlignment="Center"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" />
                    <ToggleButton x:Name="startWithWindowsToggle"
                                  Grid.Column="2"
                                  Style="{StaticResource HardwareToggleStyle}"
                                  IsChecked="True"
                                  Checked="StartWithWindowsToggle_Changed"
                                  Unchecked="StartWithWindowsToggle_Changed" />
                </Grid>

                <Button x:Name="exitButton"
                        Click="ExitButton_Click"
                        Height="34"
                        Background="Transparent"
                        BorderThickness="0"
                        Foreground="{StaticResource Brush.TextPrimary}"
                        HorizontalContentAlignment="Stretch"
                        Padding="4,0">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE8BB;"
                                   FontFamily="Segoe MDL2 Assets"
                                   FontSize="14"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource Brush.TextSecondary}" />
                        <TextBlock Grid.Column="1"
                                   Margin="10,0,0,0"
                                   Text="Exit"
                                   VerticalAlignment="Center"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Grid>
    </Border>
</Window>
