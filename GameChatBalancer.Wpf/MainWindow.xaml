<Window x:Class="GameChatBalancer.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="GameChatBalancer"
        Background="{DynamicResource Brush.BackgroundBase}"
        Foreground="{DynamicResource Brush.TextPrimary}"
        Height="900"
        Width="1440"
        MinWidth="1180"
        MinHeight="720"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="False"
        StateChanged="MainWindow_StateChanged"
        WindowStartupLocation="CenterScreen">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44"
                            ResizeBorderThickness="8"
                            GlassFrameThickness="0"
                            CornerRadius="10"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <Window.Resources>
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Brush.TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Root"
                                Background="{TemplateBinding Background}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="{StaticResource Brush.TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Root" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleBarCloseButtonStyle" TargetType="Button" BasedOn="{StaticResource TitleBarButtonStyle}">
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="#C42B1C" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
                <Trigger Property="IsPressed" Value="True">
                    <Setter Property="Background" Value="#A32518" />
                    <Setter Property="Foreground" Value="White" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="12,8,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="44" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid x:Name="TitleBarRoot"
              Grid.Row="0"
              Margin="8,0,8,8"
              MouseLeftButtonDown="TitleBarRoot_MouseLeftButtonDown"
              shell:WindowChrome.IsHitTestVisibleInChrome="True">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/GameChatBalancer.Wpf;component/Assets/GCB_icon.png"
                       Width="18"
                       Height="18"
                       Margin="4,0,8,0"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"
                       UseLayoutRounding="True" />
                <StackPanel>
                    <TextBlock Text="GameChatBalancer"
                               FontSize="14"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.TextPrimary}" />
                </StackPanel>
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" shell:WindowChrome.IsHitTestVisibleInChrome="True">
                <Button x:Name="btnMinimize"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="MinimizeButton_Click"
                        ToolTip="Minimize">
                    <TextBlock Text="&#xE921;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="btnMaxRestore"
                        Style="{StaticResource TitleBarButtonStyle}"
                        Click="MaxRestoreButton_Click"
                        ToolTip="Maximize">
                    <TextBlock x:Name="txtMaxRestoreGlyph" Text="&#xE922;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
                <Button x:Name="btnClose"
                        Style="{StaticResource TitleBarCloseButtonStyle}"
                        Click="CloseButton_Click"
                        ToolTip="Close">
                    <TextBlock Text="&#xE8BB;" FontFamily="Segoe MDL2 Assets" FontSize="10" />
                </Button>
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="136.522" />
            <ColumnDefinition Width="123.478"/>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="340" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,16,0" Grid.ColumnSpan="2">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel>
                    <TextBlock Text="Navigation" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" Margin="0,0,0,8" />
                </StackPanel>

                <StackPanel Grid.Row="1" Margin="0,20,0,0">
                    <RadioButton
                                 x:Name="navHome"
                                 Tag="&#xE80F;"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                 GroupName="MainNavigation"
                                   IsChecked="True"
                                   Checked="NavigationRadioButton_Checked">
                        <StackPanel>
                            <TextBlock Text="Home" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Text="Overview &amp; Control" FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                                  x:Name="navSettings"
                                 Tag="&#xE713;"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                   GroupName="MainNavigation"
                                   Checked="NavigationRadioButton_Checked">
                        <StackPanel>
                            <TextBlock Text="Settings" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Text="Configure App" FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                                  x:Name="navAbout"
                                 Tag="&#xE946;"
                                 Style="{StaticResource NavRadioButtonStyle}"
                                  GroupName="MainNavigation"
                                   Visibility="Collapsed"
                                   Margin="0"
                                   Checked="NavigationRadioButton_Checked">
                        <StackPanel>
                            <TextBlock Text="About" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Text="App Info &amp; Version" FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton
                                   x:Name="navDebug"
                                  Tag="&#xE7BA;"
                                  Style="{StaticResource NavRadioButtonStyle}"
                                   GroupName="MainNavigation"
                                    Margin="0"
                                    Checked="NavigationRadioButton_Checked">
                        <StackPanel>
                            <TextBlock Text="Debug" FontSize="17" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Text="Logs &amp; Diagnostics" FontSize="13" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,2,0,0" />
                        </StackPanel>
                    </RadioButton>
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="12">
                    <TextBlock Text="Version 2.0.0"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                    <TextBlock Text="© 2026 TheSoundCoder"
                               Margin="0,4,0,0"
                               Foreground="{StaticResource Brush.TextSecondary}"
                               HorizontalAlignment="Center"
                               TextAlignment="Center" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Column="2" Margin="0,0,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <StackPanel x:Name="homeHeaderSection" Grid.Row="0">
                <Border Style="{StaticResource CardBorderStyle}"
                        Padding="0"
                        ClipToBounds="True"
                        Background="Transparent"
                        BorderBrush="Transparent">
                    <Grid MaxHeight="280" MinHeight="140">
                        <Image Source="pack://application:,,,/GameChatBalancer.Wpf;component/Assets/Title_Background.png"
                               Stretch="Uniform"
                               HorizontalAlignment="Center"
                               VerticalAlignment="Center"
                               SnapsToDevicePixels="True" />

                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="20,0,24,45">
                            <TextBlock Text="GameChatBalancer"
                                       FontSize="36"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.TextPrimary}">
                                <TextBlock.Effect>
                                    <DropShadowEffect Color="#B0000000" BlurRadius="6" ShadowDepth="1" Opacity="0.4" />
                                </TextBlock.Effect>
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel>
                                <TextBlock Text="Audio Balance"
                                           FontSize="20"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                            </StackPanel>
                        </Grid>

                        <Grid Grid.Row="1" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Margin="0,0,12,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                    <Image Source="pack://application:,,,/GameChatBalancer.Wpf;component/Assets/Chat.png"
                                           Width="56"
                                           Height="56"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True"
                                           VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock x:Name="txtChatPercent"
                                           Text="100%"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Margin="0,2,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>

                            <Grid x:Name="balanceTrackHost" Grid.Column="1" VerticalAlignment="Center" SizeChanged="BalanceTrackHost_OnSizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Border Height="10" CornerRadius="5" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5">
                                            <GradientStop Color="{StaticResource Color.AccentChat}" Offset="0" />
                                            <GradientStop Color="#5A74D3" Offset="0.5" />
                                            <GradientStop Color="{StaticResource Color.AccentGame}" Offset="1" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Canvas IsHitTestVisible="False">
                                    <Ellipse x:Name="arduinoIndicator"
                                             Width="20"
                                             Height="20"
                                             Fill="{StaticResource Brush.TextPrimary}"
                                             Stroke="{StaticResource Brush.BorderSubtle}"
                                             StrokeThickness="1"
                                             Canvas.Top="-5" />
                                </Canvas>

                                <TextBlock x:Name="txtArduinoValue"
                                           Grid.Row="1"
                                           Text="50"
                                           Visibility="Collapsed"
                                           HorizontalAlignment="Center"
                                           Margin="0,8,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </Grid>

                            <StackPanel Grid.Column="2" Margin="12,0,0,0" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Image Source="pack://application:,,,/GameChatBalancer.Wpf;component/Assets/Gamepad.png"
                                           Width="56"
                                           Height="56"
                                           Stretch="Uniform"
                                           RenderOptions.BitmapScalingMode="HighQuality"
                                           SnapsToDevicePixels="True"
                                           UseLayoutRounding="True"
                                           VerticalAlignment="Bottom" />
                                </StackPanel>
                                <TextBlock x:Name="txtGamePercent"
                                           Text="100%"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           Margin="0,2,0,0"
                                           HorizontalAlignment="Center" />
                            </StackPanel>
                        </Grid>

                    </Grid>
                </Border>
            </StackPanel>

            <Grid x:Name="homeAssignmentsSection" Grid.Row="1" Margin="0,12,0,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" VerticalAlignment="Stretch">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardBorderStyle}" Margin="0,0,6,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Chat Apps" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                            <ListBox x:Name="chatAppsList"
                                         Grid.Row="1"
                                         Style="{StaticResource AssignmentDropListStyle}"
                                         Margin="0,8,0,0"
                                         Foreground="{StaticResource Brush.TextPrimary}"
                                          MinHeight="0"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                             AllowDrop="True"
                                         PreviewMouseLeftButtonDown="AssignmentList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="AssignmentList_PreviewMouseMove"
                                         DragOver="AssignmentList_DragOver"
                                         Drop="AssignmentList_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="16" Height="16" Source="{Binding Icon}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource CardBorderStyle}" Margin="6,0,0,0">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <TextBlock Text="Game Apps" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                            <ListBox x:Name="gameAppsList"
                                         Grid.Row="1"
                                         Style="{StaticResource AssignmentDropListStyle}"
                                         Margin="0,8,0,0"
                                         Foreground="{StaticResource Brush.TextPrimary}"
                                          MinHeight="0"
                                          VerticalAlignment="Stretch"
                                          HorizontalAlignment="Stretch"
                                         AllowDrop="True"
                                         PreviewMouseLeftButtonDown="AssignmentList_PreviewMouseLeftButtonDown"
                                         PreviewMouseMove="AssignmentList_PreviewMouseMove"
                                         DragOver="AssignmentList_DragOver"
                                         Drop="AssignmentList_Drop">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,4,0,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="20" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Image Width="16" Height="16" Source="{Binding Icon}" VerticalAlignment="Center" />
                                            <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </Grid>
                    </Border>
                </Grid>

                <Border Grid.Row="1" Style="{StaticResource CardBorderStyle}" Margin="0,12,0,0" Height="170" VerticalAlignment="Bottom">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock Text="Available apps (unassigned)" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                        <ListBox x:Name="availableAppsList"
                      Grid.Row="1"
                     Style="{StaticResource AssignmentDropListStyle}"
                     Margin="0,8,0,0"
                      MinHeight="0"
                      VerticalAlignment="Stretch"
                      HorizontalAlignment="Stretch"
                     Foreground="{StaticResource Brush.TextPrimary}"
                     AllowDrop="True"
                     PreviewMouseLeftButtonDown="AssignmentList_PreviewMouseLeftButtonDown"
                     PreviewMouseMove="AssignmentList_PreviewMouseMove"
                     DragOver="AssignmentList_DragOver"
                      Drop="AssignmentList_Drop">
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,4,0,4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="20" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Image Width="16" Height="16" Source="{Binding Icon}" VerticalAlignment="Center" />
                                        <TextBlock Grid.Column="2" Text="{Binding Name}" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}" />
                                    </Grid>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="debugSection"
                    Grid.RowSpan="2"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <TextBlock Text="Debug" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                    <TextBlock Grid.Row="1" Text="Laufzeitmeldungen" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextSecondary}" />

                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.Surface1}"
                            BorderBrush="{StaticResource Brush.BorderSubtle}"
                            BorderThickness="1"
                            CornerRadius="10"
                            Padding="12"
                            Margin="0,14,0,0">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE7F5;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Noise Reduction"
                                           Margin="8,0,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ComboBox x:Name="cmbNoiseReduction"
                                      Style="{StaticResource HardwareComboBoxStyle}"
                                      ItemContainerStyle="{StaticResource HardwareComboBoxItemStyle}"
                                      Margin="0,8,0,0"
                                      Height="34"
                                      SelectionChanged="NoiseReductionComboBox_SelectionChanged" />

                            <Border x:Name="noiseReductionStateBorder"
                                    Margin="0,10,0,0"
                                    Padding="10,8"
                                    CornerRadius="8"
                                    Background="#14253E"
                                    BorderBrush="{StaticResource Brush.BorderSubtle}"
                                    BorderThickness="1">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Ellipse x:Name="noiseReductionStateDot"
                                             Width="10"
                                             Height="10"
                                             VerticalAlignment="Center"
                                             Fill="#94A3B8"
                                             Stroke="#CCFFFFFF"
                                             StrokeThickness="1"
                                             SnapsToDevicePixels="True"
                                             UseLayoutRounding="True" />

                                    <StackPanel Grid.Column="1" Margin="10,0,0,0">
                                        <TextBlock x:Name="txtNoiseReductionStateTitle"
                                                   Text="Ready"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.TextPrimary}" />
                                        <TextBlock x:Name="txtNoiseReductionStateDetail"
                                                   Text="Waiting for next change"
                                                   Foreground="{StaticResource Brush.TextSecondary}"
                                                   Margin="0,2,0,0" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="3" Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,14,0,0">
                        <ListBox x:Name="debugMessagesList"
                                 Background="Transparent"
                                 BorderThickness="0"
                                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 Foreground="{StaticResource Brush.TextPrimary}" />
                    </Border>
                </Grid>
            </Border>

            <Border x:Name="settingsSection"
                    Grid.RowSpan="2"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Settings" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                        <TextBlock Text="Configure general app behavior, overlay and software controls."
                                   Margin="0,6,0,0"
                                   Foreground="{StaticResource Brush.TextSecondary}" />

                        <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,18,0,0">
                            <StackPanel>
                                <TextBlock Text="General"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Text="Application-wide preferences."
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="0,10,0,12" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Start with Windows" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                                        <TextBlock Text="Launch GameChatBalancer automatically after sign-in." Margin="0,4,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </StackPanel>
                                    <ToggleButton x:Name="tglSettingsStartWithWindows"
                                                  Grid.Column="1"
                                                  Style="{StaticResource HardwareToggleStyle}"
                                                  Checked="StartWithWindowsToggle_Changed"
                                                  Unchecked="StartWithWindowsToggle_Changed" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Overlay"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Text="Show an in-game overlay when balance values change."
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="0,10,0,12" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Enable Overlay" FontSize="14" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />
                                        <TextBlock Text="Display overlay whenever Game/Chat balance updates." Margin="0,4,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                                    </StackPanel>
                                    <ToggleButton x:Name="tglOverlayEnabled"
                                                   Grid.Column="1"
                                                   Style="{StaticResource HardwareToggleStyle}"
                                                   Checked="OverlayEnabledToggle_Changed"
                                                   Unchecked="OverlayEnabledToggle_Changed" />
                                </Grid>

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Display Duration" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}" />
                                    <ComboBox x:Name="cmbOverlayDuration"
                                              Grid.Column="1"
                                              Style="{StaticResource HardwareComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource HardwareComboBoxItemStyle}"
                                              Height="34"
                                              SelectionChanged="OverlayDurationComboBox_SelectionChanged">
                                        <ComboBoxItem Tag="1000" Content="1 s" />
                                        <ComboBoxItem Tag="2000" Content="2 s" />
                                        <ComboBoxItem Tag="3000" Content="3 s" />
                                        <ComboBoxItem Tag="4000" Content="4 s" />
                                        <ComboBoxItem Tag="5000" Content="5 s" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,10,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Overlay Position" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}" />
                                    <ComboBox x:Name="cmbOverlayPosition"
                                              Grid.Column="1"
                                              Style="{StaticResource HardwareComboBoxStyle}"
                                              ItemContainerStyle="{StaticResource HardwareComboBoxItemStyle}"
                                              Height="34"
                                              SelectionChanged="OverlayPositionComboBox_SelectionChanged">
                                        <ComboBoxItem Content="TopLeft" />
                                        <ComboBoxItem Content="TopCenter" />
                                        <ComboBoxItem Content="TopRight" />
                                        <ComboBoxItem Content="CenterLeft" />
                                        <ComboBoxItem Content="Center" />
                                        <ComboBoxItem Content="CenterRight" />
                                        <ComboBoxItem Content="BottomLeft" />
                                        <ComboBoxItem Content="BottomCenter" />
                                        <ComboBoxItem Content="BottomRight" />
                                    </ComboBox>
                                </Grid>

                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="180" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="56" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Overlay Opacity" VerticalAlignment="Center" Foreground="{StaticResource Brush.TextPrimary}" />
                                    <Slider x:Name="sldOverlayOpacity"
                                            Grid.Column="1"
                                            Minimum="20"
                                            Maximum="100"
                                            TickFrequency="5"
                                            IsSnapToTickEnabled="True"
                                            ValueChanged="OverlayOpacitySlider_ValueChanged" />
                                    <TextBlock x:Name="txtOverlayOpacityValue"
                                               Grid.Column="2"
                                               HorizontalAlignment="Right"
                                               VerticalAlignment="Center"
                                               Foreground="{StaticResource Brush.TextSecondary}"
                                               Text="90%" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="12" Padding="16" Margin="0,14,0,0">
                            <StackPanel>
                                <TextBlock Text="Hotkeys"
                                           FontSize="16"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Text="Software Control shortcuts (active only when hardware is disconnected)."
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <Border Height="1" Background="{StaticResource Brush.BorderSubtle}" Margin="0,10,0,12" />
                                <TextBlock x:Name="txtSettingsHotkeysState"
                                           Text="Status: waiting for hardware state"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <TextBlock Text="Ctrl + Shift + Left: move toward Chat"
                                           Margin="0,8,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="Ctrl + Shift + Right: move toward Game"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                                <TextBlock Text="Step size: 5%"
                                           Margin="0,4,0,0"
                                           Foreground="{StaticResource Brush.TextSecondary}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border x:Name="aboutSection"
                    Grid.RowSpan="2"
                    Style="{StaticResource CardBorderStyle}"
                    Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="About" FontSize="24" FontWeight="Bold" Foreground="{StaticResource Brush.TextPrimary}" />
                    <TextBlock Text="GameChatBalancer Informationen" Margin="0,6,0,0" Foreground="{StaticResource Brush.TextSecondary}" />
                    <Border Background="{StaticResource Brush.Surface1}" BorderBrush="{StaticResource Brush.BorderSubtle}" BorderThickness="1" CornerRadius="10" Padding="14" Margin="0,18,0,0">
                        <TextBlock Text="Version und Projektinformationen folgen (Placeholder)." Foreground="{StaticResource Brush.TextSecondary}" />
                    </Border>
                </StackPanel>
            </Border>
        </Grid>

        <StackPanel Grid.Column="3">
            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Text="Hardware Status" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" VerticalAlignment="Center" />
                        <Ellipse x:Name="hardwareStatusDot"
                                 Grid.Column="1"
                                 Width="12"
                                 Height="12"
                                 Fill="{StaticResource Brush.Warning}"
                                 StrokeThickness="1"
                                 VerticalAlignment="Center"
                                 SnapsToDevicePixels="True"
                                 UseLayoutRounding="True"
                                 ToolTip="Disconnected" />
                    </Grid>
                    <TextBlock x:Name="txtArduinoStatus" Text="Arduino: Disconnected" Foreground="{StaticResource Brush.TextSecondary}" Margin="0,8,0,0" />

                    <Separator Margin="0,12,0,10" Background="{StaticResource Brush.BorderSubtle}" />

                    <StackPanel x:Name="hardwareControlsSection">
                        <Grid Margin="0,0,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="&#xE8AB;"
                                           FontFamily="Segoe MDL2 Assets"
                                           FontSize="14"
                                           Foreground="{StaticResource Brush.TextSecondary}"
                                           VerticalAlignment="Center" />
                                <TextBlock Text="Invert Control"
                                           Margin="8,0,0,0"
                                           FontSize="14"
                                           FontWeight="SemiBold"
                                           Foreground="{StaticResource Brush.TextPrimary}"
                                           VerticalAlignment="Center" />
                            </StackPanel>

                            <ToggleButton x:Name="tglInvertControl"
                                          Grid.Column="1"
                                          Style="{StaticResource HardwareToggleStyle}"
                                          Checked="InvertControlToggle_Changed"
                                          Unchecked="InvertControlToggle_Changed" />
                        </Grid>
                    </StackPanel>

                    <Border x:Name="softwareControlSection"
                            Visibility="Collapsed"
                            Margin="0,2,0,0"
                            Padding="12"
                            CornerRadius="10"
                            Background="{StaticResource Brush.Surface1}"
                            BorderBrush="{StaticResource Brush.BorderSubtle}"
                            BorderThickness="1">
                        <StackPanel>
                            <TextBlock Text="Software Control"
                                       FontSize="16"
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.TextPrimary}" />
                            <TextBlock Text="Use keyboard shortcuts to adjust the game/chat balance in 5% steps."
                                       Margin="0,6,0,0"
                                       TextWrapping="Wrap"
                                       Foreground="{StaticResource Brush.TextSecondary}" />

                            <Grid Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Balance towards Chat"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <Border Grid.Column="1"
                                        Padding="8,4"
                                        CornerRadius="7"
                                        Background="#1B3658"
                                        BorderBrush="{StaticResource Brush.BorderSubtle}"
                                        BorderThickness="1">
                                    <TextBlock Text="Ctrl + Shift + ←"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextPrimary}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Balance towards Game"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <Border Grid.Column="1"
                                        Padding="8,4"
                                        CornerRadius="7"
                                        Background="#1B3658"
                                        BorderBrush="{StaticResource Brush.BorderSubtle}"
                                        BorderThickness="1">
                                    <TextBlock Text="Ctrl + Shift + →"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextPrimary}" />
                                </Border>
                            </Grid>

                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Center Balance"
                                           VerticalAlignment="Center"
                                           Foreground="{StaticResource Brush.TextPrimary}" />
                                <Border Grid.Column="1"
                                        Padding="8,4"
                                        CornerRadius="7"
                                        Background="#1B3658"
                                        BorderBrush="{StaticResource Brush.BorderSubtle}"
                                        BorderThickness="1">
                                    <TextBlock Text="Ctrl + Shift + ↓"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.TextPrimary}" />
                                </Border>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <TextBlock Text="Quick Actions" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Brush.TextPrimary}" />

                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Enable Overlay"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" />
                        <ToggleButton x:Name="tglQuickOverlayEnabled"
                                      Grid.Column="1"
                                      Style="{StaticResource HardwareToggleStyle}"
                                      Checked="OverlayEnabledToggle_Changed"
                                      Unchecked="OverlayEnabledToggle_Changed" />
                    </Grid>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="Start with Windows"
                                   FontSize="14"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource Brush.TextPrimary}"
                                   VerticalAlignment="Center" />
                        <ToggleButton x:Name="tglStartWithWindows"
                                      Grid.Column="1"
                                      Style="{StaticResource HardwareToggleStyle}"
                                      Checked="StartWithWindowsToggle_Changed"
                                      Unchecked="StartWithWindowsToggle_Changed" />
                    </Grid>
                </StackPanel>
            </Border>

        </StackPanel>
        </Grid>
    </Grid>
</Window>
